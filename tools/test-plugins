"""Exercise both helpers offscreen without changing desktop configuration."""
from pathlib import Path
import os
import subprocess
import sys
import tempfile

ROOT=Path(__file__).resolve().parents[1]
sys.path.insert(0,str(ROOT))
from themekit.app import atomic_write,build_plugins,environment,resources
from themekit.paths import context

build_plugins(('glass','kate'))
home=Path(tempfile.mkdtemp(prefix='niri-dms-plugin-test-'))
ctx=context(str(home))
for item in resources(ctx,'dark'): atomic_write(item,home)
env=os.environ.copy(); env.update(environment(ctx))
env.update(HOME=str(home),XDG_CONFIG_HOME=ctx['CONFIG_HOME'],XDG_DATA_HOME=ctx['DATA_HOME'],XDG_STATE_HOME=ctx['STATE_HOME'],XDG_CACHE_HOME=ctx['CACHE_HOME'],QT_QPA_PLATFORM='offscreen')
build=ROOT/'build/kate-tests'
subprocess.run(['cmake','-S',str(ROOT/'plugins/kate-balanced-glass/tests'),'-B',str(build),'-DCMAKE_BUILD_TYPE=Release'],check=True)
subprocess.run(['cmake','--build',str(build),'--parallel','2'],check=True)
env['BALANCED_GLASS_PLUGIN']=str(Path(ctx['PLUGIN_ROOT'])/'kf6/ktexteditor/katebalancedglassplugin.so')
subprocess.run([str(build/'balancedglass-test')],env=env,check=True)
env['QT_STYLE_OVERRIDE']='NiriGlass'
env['NIRI_GLASS_TEST_HOME']='1'
subprocess.run([str(ROOT/'build/glass/style-test')],env=env,check=True)
print('PASS: scoped helper tests; no live installation or service restart')
